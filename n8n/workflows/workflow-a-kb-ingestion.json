    {
      "parameters": {
        "jsCode": "// Find same-website links on the homepage (max 20 pages, homepage included).\nconst source = $('Start ingestion').first().json;\nconst home = new URL(source.source_url);\nconst html = $input.first().json.html || '';\nconst MAX_PAGES = 20;\nconst SKIP_PATH = /\\/(careers|jobs|blog|news|press|legal|privacy|terms|cookies?|login|signin|sign-in|signup|cart|tag|author)(\\/|$)/i;\nconst SKIP_EXT = /\\.(pdf|jpe?g|png|gif|svg|webp|ico|css|js|xml|zip|mp4|mp3|docx?|xlsx?)$/i;\nconst sameSite = (u) => u.hostname.replace(/^www\\./, '') === home.hostname.replace(/^www\\./, '');\nconst norm = (u) => u.origin + (u.pathname.length > 1 ? u.pathname.replace(/\\/+$/, '') : '/');\n\nconst urls = new Set([norm(home)]);\nfor (const m of html.matchAll(/href\\s*=\\s*[\"']([^\"'#]+)[\"']/gi)) {\n  let u;\n  try { u = new URL(m[1], home); } catch { continue; }\n  if (!/^https?:$/.test(u.protocol) || !sameSite(u)) continue;\n  if (SKIP_PATH.test(u.pathname) || SKIP_EXT.test(u.pathname)) continue;\n  urls.add(norm(u));\n}\nreturn [...urls].slice(0, MAX_PAGES).map((url) => ({ json: { url } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -80
      ],
      "id": "c9dd2a4b-0d82-4ee8-8ee8-c4a6f50a66af",
      "name": "Collect links",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        -80
      ],
      "id": "1103260e-7d98-406b-a2e9-814951f49404",
      "name": "Fetch pages",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Turn each page's HTML into clean readable text. Skips pages that failed or are near-empty.\nconst links = $('Collect links').all();\nconst decode = (s) => s\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"').replace(/&#39;|&rsquo;|&lsquo;/g, \"'\").replace(/&[a-z]+;|&#\\d+;/gi, ' ');\n\nconst pages = [];\n$input.all().forEach((item, i) => {\n  const html = item.json.html;\n  if (typeof html !== 'string' || !html) return;                 // page failed to load\n  const title = decode(((html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1] || '').trim());\n  const text = decode(html\n      .replace(/<(script|style|noscript|svg|nav|footer|form|iframe)\\b[\\s\\S]*?<\\/\\1>/gi, ' ')\n      .replace(/<br\\s*\\/?>|<\\/(p|div|li|h[1-6]|tr|section|article)>/gi, '\\n')\n      .replace(/<[^>]+>/g, ' '))\n    .replace(/[ \\t]+/g, ' ').replace(/\\n\\s*\\n+/g, '\\n\\n').trim();\n  if (text.length < 200) return;                                 // skip near-empty pages\n  pages.push({ json: { page_url: links[i] ? links[i].json.url : '', title, text } });\n});\nif (!pages.length) {\n  throw new Error('No readable text found on the website (it may need JavaScript to render).');\n}\nreturn pages;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
